# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Database (Postgres) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=changeme
DATABASE_NAME=skinlab

# --- Auth (JWT) ---
JWT_SECRET=replace-with-a-long-random-secret
# Optional, defaults to 7d if unset
JWT_EXPIRATION=7d

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# --- AWS S3 (product images) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=your-s3-bucket-name

# --- Server ---
# URL of the React frontend, used for CORS and Google OAuth redirects
FRONTEND_URL=http://localhost:3001
PORT=3000
